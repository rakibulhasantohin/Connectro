rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // HELPERS
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ["rakibulhasantohin@gmail.com", "rakibulhasantuhin010@gmail.com"] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }
    
    // Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256;
    }
    
    function isValidPost(data) {
      return data.keys().hasAll(['userId', 'text', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.text is string && data.text.size() <= 5000;
    }
    
    function isValidFriendship(data) {
      return data.keys().hasAll(['uids', 'createdAt']) &&
             data.uids is list && data.uids.size() == 2 &&
             request.auth.uid in data.uids;
    }

    function isValidReaction(data) {
      return data.keys().hasAll(['userId', 'type', 'createdAt']) &&
             data.type in ['like', 'love', 'care', 'haha', 'wow', 'sad', 'angry'] &&
             data.userId == request.auth.uid;
    }

    function isValidFriendRequest(data) {
      return data.keys().hasAll(['fromUserId', 'toUserId', 'createdAt']) &&
             data.fromUserId == request.auth.uid &&
             data.toUserId is string && data.toUserId.size() <= 128;
    }

    function isValidFollow(data) {
      return data.keys().hasAll(['followerId', 'followingId', 'createdAt']) &&
             data.followerId == request.auth.uid &&
             data.followingId is string && data.followingId.size() <= 128;
    }

    // ===============================================================
    // DEFAULT DENY
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // COLLECTIONS
    // ===============================================================

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && isValidUser(incoming());

      match /savedPosts/{postId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isEmailVerified() && isValidId(postId) && isValidPost(incoming());
      allow update: if isEmailVerified() && (existing().userId == request.auth.uid || isAdmin());
      allow delete: if isEmailVerified() && (existing().userId == request.auth.uid || isAdmin());

      match /reactions/{userId} {
        allow read: if isSignedIn();
        allow create, update: if isEmailVerified() && isValidId(userId) && userId == request.auth.uid && isValidReaction(incoming());
        allow delete: if isEmailVerified() && isOwner(userId);
      }
    }

    match /friendships/{friendshipId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.auth.uid in existing().uids;
      allow create: if isEmailVerified() && isValidId(friendshipId) && isValidFriendship(incoming());
      allow delete: if isEmailVerified() && (request.auth.uid in existing().uids || isAdmin());
    }

    match /friendRequests/{requestId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (existing().fromUserId == request.auth.uid || existing().toUserId == request.auth.uid);
      allow create: if isEmailVerified() && isValidId(requestId) && isValidFriendRequest(incoming());
      allow update, delete: if isEmailVerified() && (
        existing().fromUserId == request.auth.uid || 
        existing().toUserId == request.auth.uid || 
        isAdmin()
      );
    }

    match /chats/{chatId} {
      allow get: if isSignedIn() && (request.auth.uid in existing().participants || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in existing().participants || isAdmin());
      allow create: if isEmailVerified() && isValidId(chatId) && request.auth.uid in incoming().participants;
      allow update: if isEmailVerified() && (request.auth.uid in existing().participants || isAdmin());
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants || isAdmin());
        allow create: if isEmailVerified() && isValidId(messageId) && request.auth.uid == incoming().senderId;
      }
    }

    match /follows/{followId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Allow listing follows so user can see who is followed by others
      allow create: if isEmailVerified() && isValidId(followId) && isValidFollow(incoming());
      allow delete: if isEmailVerified() && (existing().followerId == request.auth.uid || isAdmin());
    }

    match /notifications/{notificationId} {
      allow get: if isOwner(existing().toUserId) || isAdmin();
      allow list: if isSignedIn() && (existing().toUserId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && isValidId(notificationId);
      allow update, delete: if isEmailVerified() && (existing().toUserId == request.auth.uid || isAdmin());
    }

    match /stories/{storyId} {
      allow read: if isSignedIn();
      allow create: if isEmailVerified() && isValidId(storyId) && incoming().userId == request.auth.uid;
      allow update: if isEmailVerified() && (
        existing().userId == request.auth.uid || 
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['views'])
      );
      allow delete: if isEmailVerified() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isEmailVerified() && isValidId(commentId) && incoming().userId == request.auth.uid;
      allow update, delete: if isEmailVerified() && (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
